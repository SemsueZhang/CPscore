{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "review": {
      "$ref": "report.schema.json"
    },
    "objects": {
      "type": "object",
      "properties": {
        "statement": {
          "$ref": "#/$defs/assessment"
        },
        "solution": {
          "$ref": "#/$defs/assessment"
        },
        "editorial": {
          "$ref": "#/$defs/assessment"
        }
      },
      "required": [
        "statement",
        "solution",
        "editorial"
      ],
      "additionalProperties": false
    },
    "overall": {
      "$ref": "#/$defs/overall_assessment"
    },
    "root_causes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/root_cause"
      }
    }
  },
  "required": [
    "schema_version",
    "review",
    "objects",
    "overall",
    "root_causes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpscore.local/schemas/v2/scored-report.schema.json",
  "title": "CPScore generated score report 2.0",
  "$comment": "validate_scored_report additionally validates the review semantics and recomputes every derived field, including qualification, coverage completion, local states, evidence references, and unique-root deductions.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "object": {
          "enum": [
            "statement",
            "solution",
            "editorial"
          ]
        },
        "finding_id": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "object",
        "finding_id",
        "evidence_index"
      ],
      "additionalProperties": false
    },
    "local_state": {
      "type": "object",
      "properties": {
        "object": {
          "enum": [
            "statement",
            "solution",
            "editorial"
          ]
        },
        "status": {
          "enum": [
            "confirmed",
            "suspected",
            "resolved"
          ]
        },
        "points": {
          "enum": [
            0,
            1,
            10
          ]
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      },
      "required": [
        "object",
        "status",
        "points",
        "finding_ids",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "root_cause": {
      "type": "object",
      "properties": {
        "root_cause_id": {
          "$ref": "#/$defs/identifier"
        },
        "severity": {
          "enum": [
            "fatal",
            "minor"
          ]
        },
        "status": {
          "enum": [
            "confirmed",
            "suspected",
            "resolved"
          ]
        },
        "points": {
          "enum": [
            0,
            1,
            10
          ]
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1
        },
        "affected_objects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "statement",
              "solution",
              "editorial"
            ]
          },
          "minItems": 1
        },
        "local_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/local_state"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      },
      "required": [
        "root_cause_id",
        "severity",
        "status",
        "points",
        "finding_ids",
        "affected_objects",
        "local_states",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "qualification": {
          "enum": [
            "pass",
            "fail",
            "undetermined"
          ]
        },
        "completion": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "initial_score": {
          "const": 10
        },
        "pass_threshold": {
          "const": 6
        },
        "total_penalty": {
          "type": "integer",
          "minimum": 0
        },
        "deductions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/root_cause"
          }
        },
        "pending_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "suspected_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "resolved_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "required": [
        "qualification",
        "completion",
        "score",
        "initial_score",
        "pass_threshold",
        "total_penalty",
        "deductions",
        "pending_finding_ids",
        "suspected_finding_ids",
        "resolved_finding_ids"
      ],
      "additionalProperties": false
    },
    "overall_assessment": {
      "type": "object",
      "properties": {
        "qualification": {
          "enum": [
            "pass",
            "fail",
            "undetermined"
          ]
        },
        "completion": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "initial_score": {
          "const": 10
        },
        "pass_threshold": {
          "const": 6
        },
        "total_penalty": {
          "type": "integer",
          "minimum": 0
        },
        "deductions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/root_cause"
          }
        },
        "pending_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "suspected_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "resolved_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "statement",
              "solution",
              "editorial"
            ]
          },
          "minItems": 1
        },
        "completed_objects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "statement",
              "solution",
              "editorial"
            ]
          }
        },
        "incomplete_objects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "statement",
              "solution",
              "editorial"
            ]
          }
        },
        "aggregation": {
          "const": "unique_root_causes_across_in_scope_objects"
        }
      },
      "required": [
        "qualification",
        "completion",
        "score",
        "initial_score",
        "pass_threshold",
        "total_penalty",
        "deductions",
        "pending_finding_ids",
        "suspected_finding_ids",
        "resolved_finding_ids",
        "scope",
        "completed_objects",
        "incomplete_objects",
        "aggregation"
      ],
      "additionalProperties": false
    }
  }
}

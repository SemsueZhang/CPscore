include README.md pyproject.toml MANIFEST.in .gitignore .gitattributes Dockerfile.runner
recursive-include cpscore/schemas *.json
recursive-include skills *.md
recursive-include docs *.md
recursive-include scripts *.py
recursive-include fixtures *
recursive-include tests *.py *.json *.md *.zip
recursive-include .github *.yml *.yaml
prune build
prune dist
prune reports
prune outputs
prune .cpscore
global-exclude __pycache__ *.py[cod] .DS_Store
